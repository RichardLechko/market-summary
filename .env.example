# Copy to .env and fill in. .env is gitignored; never commit it.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Free key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Free key for earnings call transcripts (deep-tier companies):
# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# SEC requires a descriptive User-Agent with contact details, e.g.
# "market-summary your-email@example.com"
SEC_USER_AGENT=

# Gmail: enable 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER
MAIL_FROM=
# Comma-separated
MAIL_TO=
